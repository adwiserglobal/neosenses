# ===========================================
# NeoSenses — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─── Supabase ─────────────────────────────
# As três são necessárias em produção para painel, formulários e Concierge.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Vercel AI Gateway ───────────────────
# Em produção, a Vercel injeta um token OIDC de curta duração no header
# x-vercel-oidc-token de cada requisição. Localmente, `vercel env pull` pode
# disponibilizar VERCEL_OIDC_TOKEN. Fora da Vercel, use uma chave do Gateway.
AI_GATEWAY_API_KEY=
# Modelo padrão econômico. IDs devem existir no catálogo do AI Gateway.
AI_GATEWAY_MODEL=google/gemini-2.5-flash-lite

# ─── E-mail (Resend) ──────────────────────
RESEND_API_KEY=
EMAIL_EQUIPE=
EMAIL_REMETENTE=NeoSenses <contato@neosenses.com.br>

# ─── WhatsApp ─────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=5511947188319

# ─── App ──────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NeoSenses
NEXT_PUBLIC_DEFAULT_LOCALE=pt
NEXT_PUBLIC_SITE_URL=https://www.neosenses.com.br

# ─── Acesso ao painel interno ─────────────
# Configure SOMENTE como variável secreta do servidor na Vercel.
# JSON com hashes PBKDF2 das duas credenciais de provisionamento inicial.
# Nunca coloque senhas em texto puro no repositório ou no .env.example.
# A lista de e-mails permitidos também é validada no servidor e no RLS.
INTERNAL_ADMIN_BOOTSTRAP_USERS=

# ─── Analytics (optional) ─────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
