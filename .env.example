# ===========================================
# NeoSenses — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─── Supabase ─────────────────────────────
# As três são necessárias em produção para painel, formulários e Concierge.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Vercel AI Gateway ───────────────────
# Em produção na Vercel, prefira OIDC: VERCEL_OIDC_TOKEN é injetado no deploy
# quando o projeto está configurado para emitir tokens OIDC.
# Para desenvolvimento local ou hospedagem externa, use uma chave do AI Gateway.
AI_GATEWAY_API_KEY=
# Modelo padrão econômico. IDs devem existir no catálogo do AI Gateway.
AI_GATEWAY_MODEL=google/gemini-2.5-flash-lite

# ─── E-mail (Resend) ──────────────────────
RESEND_API_KEY=
EMAIL_EQUIPE=
EMAIL_REMETENTE=NeoSenses <contato@neosenses.com.br>

# ─── WhatsApp ─────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=5511947188319

# ─── App ──────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NeoSenses
NEXT_PUBLIC_DEFAULT_LOCALE=pt
NEXT_PUBLIC_SITE_URL=https://www.neosenses.com.br

# ─── Primeiro administrador ───────────────
# Defina SOMENTE como secrets do servidor (Vercel Environment Variables).
# No primeiro login com esse par, o app cria/confirma o usuário no Supabase
# Auth e o promove para admin. A senha não deve entrar no Git.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Analytics (optional) ─────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
