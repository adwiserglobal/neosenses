# ===========================================
# NeoSenses — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─── Supabase ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI Concierge ─────────────────────────
# Provider: auto-detected from available API key.
# OpenRouter has priority when OPENROUTER_API_KEY is configured.
# Options: "openrouter" | "openai" | "gemini" | "anthropic" (leave empty for auto-detect)
AI_PROVIDER=
# Model. For OpenRouter, empty defaults to the official free router: openrouter/free
AI_MODEL=

# Set ONE of these (OpenRouter is checked first when auto-detecting):
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Generic alias (used if OPENAI_API_KEY is not set):
AI_API_KEY=

# ─── E-mail (Resend) ──────────────────────
# Sem estas variáveis o site funciona, mas ninguém é avisado de nada: o lead
# entra no banco e fica esperando alguém abrir o painel.
RESEND_API_KEY=

# Para onde vão os avisos de novo contato. Sem isso, a equipe não fica sabendo.
EMAIL_EQUIPE=

# Remetente. Precisa ser de um domínio verificado no Resend — do contrário a
# mensagem é recusada ou cai em spam.
EMAIL_REMETENTE=NeoSenses <contato@neosenses.com.br>

# ─── WhatsApp ─────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=5511947188319

# ─── App ──────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NeoSenses
NEXT_PUBLIC_DEFAULT_LOCALE=pt
NEXT_PUBLIC_SITE_URL=https://www.neosenses.com.br

# ─── Admin (dev only) ─────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Analytics (optional) ─────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=
